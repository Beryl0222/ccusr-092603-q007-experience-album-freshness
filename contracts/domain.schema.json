{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "生活经验专辑时效台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ALBUM_CREATED",
        "ENTRY_ADDED",
        "ENTRY_UPDATED",
        "ENTRY_MERGE_RESOLVED",
        "PLACE_REGISTERED",
        "PLACE_CHANGED",
        "PLACE_MERGED",
        "SNAPSHOT_SHARED",
        "COMMENT_ADDED",
        "CORRECTION_SUBMITTED",
        "CORRECTION_DECIDED",
        "AUTHOR_WITHDREW",
        "COLLABORATOR_INVITED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "experience_album",
        "place_revision",
        "shared_snapshot",
        "correction_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "ALBUM_CREATED": [],
    "ENTRY_ADDED": [
      "experience_at",
      "audience_conditions"
    ],
    "ENTRY_UPDATED": [
      "entry_id"
    ],
    "ENTRY_MERGE_RESOLVED": [
      "entry_id",
      "base_version"
    ],
    "PLACE_REGISTERED": [
      "place_id",
      "place_version"
    ],
    "SNAPSHOT_SHARED": [
      "snapshot_hash",
      "recipient_scope"
    ],
    "PLACE_CHANGED": [
      "place_version",
      "changed_facts"
    ],
    "PLACE_MERGED": [
      "old_place_id",
      "new_place_id"
    ],
    "COMMENT_ADDED": [
      "comment_id",
      "entry_id",
      "quote",
      "place_id",
      "place_version"
    ],
    "CORRECTION_SUBMITTED": [
      "case_id",
      "subject_id",
      "factual_patches"
    ],
    "CORRECTION_DECIDED": [
      "case_id",
      "decision"
    ],
    "AUTHOR_WITHDREW": [
      "entry_id"
    ],
    "COLLABORATOR_INVITED": [
      "user_id"
    ]
  },
  "additionalProperties": false
}
